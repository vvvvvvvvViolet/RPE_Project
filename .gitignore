# servers, service accounts, tag paths and licence identifiers. They are kept
# out of version control deliberately. The test suite builds its own synthetic
# fixtures instead; see tests/RPEReader.Core.Tests/TestData/SampleBuilder.cs.
samples/*.rpe
*.rpe
