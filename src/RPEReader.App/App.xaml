<Application x:Class="RPEReader.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RPEReader.App.Converters">
  <Application.Resources>
    <ResourceDictionary>

      <conv:SearchModeConverter x:Key="SearchModeConverter" />

      <SolidColorBrush x:Key="PanelBackground" Color="#FFF7F8FA" />
      <SolidColorBrush x:Key="PanelBorder"     Color="#FFD6DAE0" />
      <SolidColorBrush x:Key="MutedText"       Color="#FF6B7280" />
      <SolidColorBrush x:Key="AccentText"      Color="#FF1F4E79" />

      <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AccentText}" />
        <Setter Property="Margin" Value="0,0,0,4" />
      </Style>

      <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedText}" />
        <Setter Property="Margin" Value="0,2,8,2" />
      </Style>

      <Style x:Key="FieldValue" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="TextWrapping" Value="NoWrap" />
      </Style>

      <Style x:Key="Monospace" TargetType="TextBox" BasedOn="{StaticResource FieldValue}">
        <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
